PORT=3000

POSTGRES_CONNECTION_URL=postgres://user:password@host:5432/postgres

RIOT_API_KEY=RGAPI-
# Key thứ 2, chỉ dùng fetch match timeline. Puuid mã hóa theo key nên timeline chỉ map qua participantId.
RIOT_TIMELINE_API_KEY=RGAPI-

# Trần thật của key; rate limiter tự chừa đệm an toàn bên dưới. Bỏ trống = 20 / 100.
RIOT_RATE_PER_SEC=20
RIOT_RATE_PER_2MIN=100

# Số giây nghỉ giữa 2 player trong 1 lượt crawl match. Bỏ trống = 30.
LOL_CRAWL_FREQ_SEC=30
